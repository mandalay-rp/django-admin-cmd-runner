import traceback

from celery import shared_task
from django.core.management import call_command

from . import store
from .reporter import (
    Reporter,
    CommandStopRequested,
    clear_current_run,
    set_current_run,
)


@shared_task(bind=True)
def run_command_task(self, run_id, command_name, args=None, kwargs=None):
    args = args or []
    kwargs = kwargs or {}

    if store.get_state(run_id) is None:
        return {"status": "skipped", "reason": "state not found"}

    store.update_state(
        run_id,
        status="running",
        started_at=store.now_iso(),
        task_id=self.request.id,
    )
    set_current_run(run_id)

    reporter = Reporter(run_id)
    try:
        call_command(command_name, *args, stdout=reporter, stderr=reporter, **kwargs)
        if store.is_stop_requested(run_id):
            store.update_state(run_id, status="stopped", finished_at=store.now_iso())
        else:
            store.update_state(run_id, status="success", finished_at=store.now_iso())
    except CommandStopRequested as exc:
        store.update_state(
            run_id, status="stopped", error=str(exc), finished_at=store.now_iso(),
        )
    except SystemExit:
        # может прийти после revoke(terminate=True, signal="SIGTERM")
        store.update_state(
            run_id, status="stopped", error="terminated", finished_at=store.now_iso(),
        )
    except Exception:
        store.update_state(
            run_id,
            status="error",
            error=traceback.format_exc(),
            finished_at=store.now_iso(),
        )
    finally:
        clear_current_run()
        store.release_lock(run_id)

    return {"status": (store.get_state(run_id) or {}).get("status")}
